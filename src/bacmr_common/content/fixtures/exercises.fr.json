      "id": "ex-1",
      "exercise_type": "mcq",
      "stem": "Combien de solutions réelles a $x^2+x+1=0$ ?",
      "choices": [
        "0",
        "1",
        "2"
      ],
      "correct_choices": [
        0
      ],
      "answer": "Aucune, car $\\Delta=-3<0$.",
      "solution_steps": [
        "$\\Delta=1-4=-3$.",
        "$\\Delta<0$ donc aucune solution."
      ],
      "difficulty": "easy",
      "concept_ids": [
        "concept:discriminant"
      ],
      "points": 1
    },
    {
      "type": "exercise",
      "lang": "fr",
      "dir": "ltr",
      "id": "ex-2",
      "exercise_type": "short",
      "stem": "Résoudre $2x^2-8=0$.",
      "answer": "$x=-2$ ou $x=2$.",
