      "title": "التعريف",
      "items": [
        "نسمي العدد $\\Delta=b^2-4ac$ **مميز** المعادلة."
      ],
      "minutes": 10
    },
    {
      "type": "board_zone",
      "lang": "ar",
      "dir": "rtl",
      "zone": "center",
      "title": "مثال",
      "items": [
        "$a=1$ و $b=-5$ و $c=6$.",
        "$\\Delta=25-24=1>0$ إذن للمعادلة حلان.",
        "$x_1=2$ و $x_2=3$."
      ],
      "minutes": 20
    },
    {
      "type": "board_zone",
      "lang": "ar",
      "dir": "rtl",
