          "title": "Zone",
          "type": "string"
        },
        "title": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "items": {
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "minutes": {
          "anyOf": [
            {
              "maximum": 240,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minutes"
        }
      },
      "required": [
        "lang",
        "dir",
        "type",
        "zone",
        "title",
        "items"
      ],
      "title": "BoardZone",
      "type": "object"
