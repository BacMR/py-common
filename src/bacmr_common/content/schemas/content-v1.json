          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "type": {
          "const": "board_zone",
          "title": "Type",
          "type": "string"
        },
        "zone": {
          "enum": [
            "left",
            "center",
            "right",
            "top",
            "bottom",
            "full"
