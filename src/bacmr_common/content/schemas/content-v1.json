          }
        }
      ],
      "description": "One display formula. `latex` has no `$` delimiters and is always rendered LTR;\n`lang`/`dir` apply to the caption and to the block's placement in the page.",
      "properties": {
        "lang": {
          "enum": [
            "ar",
            "fr",
            "en"
          ],
          "title": "Lang",
          "type": "string"
        },
        "dir": {
          "enum": [
            "rtl",
            "ltr"
          ],
          "title": "Dir",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "type": {
          "const": "formula",
          "title": "Type",
          "type": "string"
        },
        "latex": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*(?:\\\\(?:input|include|write|immediate|openout|openin|read|def|gdef|edef|xdef|let|newcommand|renewcommand|providecommand|DeclareMathOperator|catcode|csname|url|href|includegraphics|special|class|style|cssId|require|unicode|htmlClass|htmlId|htmlStyle|htmlData|newenvironment|renewenvironment|DeclareRobustCommand|expandafter)(?![A-Za-z])|\\^\\^))",
          "title": "Latex",
          "type": "string"
        },
        "caption": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        }
      },
      "required": [
        "lang",
        "dir",
        "type",
        "latex"
      ],
      "title": "Formula",
      "type": "object"
    },
