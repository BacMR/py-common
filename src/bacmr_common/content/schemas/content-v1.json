    "BoardZone": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "dir": {
                "const": "ltr"
              }
            }
          },
          "if": {
            "properties": {
              "lang": {
                "const": "ar"
              }
            }
          },
          "then": {
            "properties": {
              "dir": {
                "const": "rtl"
              }
            }
          }
        }
      ],
      "description": "One zone of a whiteboard plan: what the teacher writes there, in order.",
